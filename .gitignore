# This .gitignore file is template for Unity projects

/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

# MemoryCaptures can get large and should not be tracked
/[Mm]emoryCaptures/

# Asset store packages (re-downloadable)
/[Aa]ssets/AssetStoreTools*

# Autogenerated VS/VS Code project files
/*.csproj
/*.unityproj
/*.sln
/*.suo
/*.tmp
/*.user
/*.userprefs
/*.pidb
/*.booproj
/*.svd
/*.class
/*.targets

# OS generated files
.DS_Store
Thumbs.db

# Visual Studio / IDE
/.vs/
/.utmp/
*.vsconfig

# Exported builds
/[Bb]uild[s]*/
/*.exe

# Downloaded assets (re-downloadable)
/kenney_physicsAssets_v2/

# Reference files in root (not part of the game)
/Mobile - Angry Birds*/
/*.wav
/*.mp3
/*.png
